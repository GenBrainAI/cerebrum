{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Python Debugger: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
    },
    {
        "name": "Python: Run Tests",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
            "tests/"
        ],
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
        }
    },
    {
        "name": "Python: Test Explorer",
        "type": "debugpy",
        "request": "launch",
        "console": "integratedTerminal",
        "module": "pytest",
        "justMyCode": false,
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
        }
    },
    {
        "name": "FastAPI: Debug",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
            "src.server.main:app",
            "--host", "0.0.0.0",
            "--port", "8080",
            "--reload"
        ],
        "jinja": false,
        "console": "integratedTerminal"
    },
    {
        "name": "Python: Server Temp",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/src/server/temp.py",
        "console": "integratedTerminal",
        "env": {
            "PYTHONPATH": "${workspaceFolder}/src"
        }
    },
    {
        "name": "Python: Streamlit",
        "type": "debugpy",
        "request": "launch",
        "module": "streamlit",
        "args": [
            "run",
            "src/chat.py",
            "--server.port",
            "8001"
        ],
        "justMyCode": true
    },
    {
        "name": "Python: Attach to Streamlit",
        "type": "debugpy",
        "request": "attach",
        "connect": {
            "host": "localhost",
            "port": 5678
        },
        "justMyCode": false
    }
  ]
}